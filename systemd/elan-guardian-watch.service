[Unit]
Description=Escalate unsuccessful ELAN kernel recoveries
Documentation=man:elan-guardian(8)
After=systemd-udev-settle.service
ConditionPathExists=/sys/bus/i2c/drivers/elan_i2c

[Service]
Type=simple
ExecStart=/usr/bin/elan-guardian watch --affected-only --interval-ms 1000
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/sys/bus/i2c/drivers/elan_i2c

[Install]
WantedBy=multi-user.target
